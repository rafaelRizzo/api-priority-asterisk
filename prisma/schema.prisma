datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model trunks {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId// MongoDB usa _id como chave primária
  trunkid       Int     @default(0)
  name          String  @default("") @db.String
  tech          String  @db.String
  outcid        String  @default("") @db.String
  keepcid       String? @default("off") @db.String
  maxchans      String? @default("") @db.String
  failscript    String  @default("") @db.String
  dialoutprefix String  @default("") @db.String
  channelid     String  @default("") @db.String
  usercontext   String? @db.String
  provider      String? @db.String
  disabled      String? @default("off") @db.String
  continue      String? @default("off") @db.String

  @@unique([trunkid, tech, channelid]) // MongoDB não suporta @@id composto, mas pode usar índice único
}

model priorities_api {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  trunk        String    @unique @db.String
  priority     Int       @default(1)
  start_date   DateTime
  end_date     DateTime?
  created_date DateTime
}
